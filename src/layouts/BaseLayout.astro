---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  path?: string;
  image?: string;
}

const {
  title = site.title,
  description = site.description,
  type = 'website',
  publishedTime,
  updatedTime,
  path = Astro.url.pathname,
  image,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const pageTitle = title === site.title ? title : `${title} — ${site.name}`;
const imageUrl = image ? new URL(image, site.url).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      inLanguage: site.language,
      publisher: { '@id': `${site.url}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.author.name,
      givenName: site.author.givenName,
      familyName: site.author.familyName,
      url: site.url,
      jobTitle: site.author.jobTitle,
      sameAs: site.author.sameAs,
    },
  ],
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href="/fonts/unbounded-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#content">К содержанию</a>
    <Header />
    <main id="content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
