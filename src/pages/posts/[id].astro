---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articlePath, getPublishedArticles } from '../../lib/articles';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const published = article.data.pubDate.toISOString();
const updated = (article.data.updatedDate ?? article.data.pubDate).toISOString();
const formatted = article.data.pubDate.toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: published,
  dateModified: updated,
  inLanguage: site.language,
  author: {
    '@type': 'Person',
    name: site.author.name,
    url: site.url,
  },
  mainEntityOfPage: new URL(articlePath(article), site.url).href,
  ...(article.data.cover
    ? { image: new URL(article.data.cover, site.url).href }
    : {}),
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  type="article"
  publishedTime={published}
  updatedTime={updated}
  path={articlePath(article)}
  image={article.data.cover}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  </Fragment>

  <article class="wrap">
    <header class="article-header">
      <div class="meta">
        <time datetime={published}>{formatted}</time>
        {article.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
      <h1>{article.data.title}</h1>
      <p class="lede" style="margin-inline: 0;">{article.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="section">
      <a class="muted-link" href="/posts/">← Все посты</a>
    </p>
  </article>
</BaseLayout>
