---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import { getPublishedArticles } from '../../lib/articles';

const n = (await getPublishedArticles()).length;
const n10 = n % 10;
const n100 = n % 100;
const countWord =
  n10 === 1 && n100 !== 11
    ? 'материал'
    : n10 >= 2 && n10 <= 4 && (n100 < 12 || n100 > 14)
      ? 'материала'
      : 'материалов';
---

<BaseLayout
  title="Статьи"
  description="Заметки Ивана Комиссарова про геймдизайн, игропрактику, Граникон и образовательные игры."
>
  <section class="page-hero wrap">
    <p class="hero-kicker">Архив</p>
    <h1 class="page-title">
      Статьи
      <br />
      <span class="gradient-text">Игры, курсы, конвенты</span>
    </h1>
    <p class="lede" style="margin-inline: 0;">
      {n} {countWord}. Новые появляются сверху.
    </p>
  </section>

  <section class="section wrap">
    <ArticleGrid />
  </section>
</BaseLayout>
