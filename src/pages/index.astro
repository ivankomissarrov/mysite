---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="hero wrap">
    <span class="glow-orb" style="top: -40px; left: 8%;"></span>
    <span class="glow-orb" style="right: 6%; top: 40px; background: radial-gradient(circle, rgba(92,225,255,.22), transparent 68%);"></span>
    <p class="hero-kicker">Игропрактика и геймдизайн</p>
    <h1>
      {site.name}
      <br />
      <span class="gradient-text">Игры для образования</span>
    </h1>
    <p class="lede">
      Делаю настольные и образовательные игры, веду курсы и собираю конвенты. Здесь — рабочие заметки,
      которые раньше жили во ВКонтакте.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/articles/">Читать статьи</a>
      <a class="btn btn-ghost" href="/about/">Обо мне</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="grid-3">
      <article class="card">
        <h3>Настольный геймдизайн</h3>
        <p>Игры «под ключ», прототипы, консультации по механикам и работа с непрофильными заказчиками.</p>
      </article>
      <article class="card">
        <h3>Игропрактика</h3>
        <p>Курсы и интенсивы для педагогов, механики под образовательные цели, живое действие и настолки.</p>
      </article>
      <article class="card">
        <h3>Ивенты</h3>
        <p>Граникон, Гильдия разработчиков настольных игр, программы для студентов и подростков.</p>
      </article>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Статьи</h2>
      <a class="muted-link" href="/articles/">Архив</a>
    </div>
    <ArticleGrid />
  </section>
</BaseLayout>
