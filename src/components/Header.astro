---
import { site } from '../data/site';
import Avatar from './Avatar.astro';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <Avatar class="brand-avatar" size={38} decorative />
      <span>{site.name}</span>
    </a>
    {
      site.nav.length > 0 && (
        <nav class="nav" aria-label="Основное меню">
          {site.nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
    <a class="header-phone" href={`tel:${site.phoneTel}`} data-phone-copy={site.phone} data-face="smile">
      <svg class="header-phone-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 3c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"
        />
      </svg>
      {site.phone}
    </a>
  </div>
</header>

<p class="copy-toast" data-copy-toast role="status">Телефон скопирован</p>

<script>
  const toastTimers = new WeakMap();

  function isMobilePhone() {
    const uaData = navigator.userAgentData;
    if (uaData && typeof uaData.mobile === 'boolean') return uaData.mobile;
    return /Mobi|Android.*Mobile|iPhone|iPod/i.test(navigator.userAgent);
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.left = '-9999px';
      document.body.appendChild(field);
      field.select();
      const ok = document.execCommand('copy');
      field.remove();
      return ok;
    }
  }

  function showCopied() {
    const toast = document.querySelector('[data-copy-toast]');
    if (!(toast instanceof HTMLElement)) return;
    toast.classList.add('is-on');
    const prev = toastTimers.get(toast);
    if (prev) clearTimeout(prev);
    toastTimers.set(
      toast,
      setTimeout(() => toast.classList.remove('is-on'), 2200),
    );
  }

  document.addEventListener('click', async (event) => {
    const link = event.target instanceof Element ? event.target.closest('[data-phone-copy]') : null;
    if (!(link instanceof HTMLAnchorElement)) return;
    if (isMobilePhone()) return;
    event.preventDefault();
    const text = link.getAttribute('data-phone-copy') ?? '';
    if (await copyText(text)) showCopied();
  });
</script>
