---
import { site } from '../data/site';
import Avatar from './Avatar.astro';

const path = Astro.url.pathname;
const headerSocials = site.messengers.filter((item) => item.id === 'vk' || item.id === 'telegram');
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <Avatar class="brand-avatar" size={38} decorative plain />
      <span class="brand-name">{site.name}</span>
    </a>
    {
      site.nav.length > 0 && (
        <nav class="nav" aria-label="Основное меню">
          {site.nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
    <div class="header-actions">
      <div class="header-socials" aria-label="Написать в мессенджере">
        {
          headerSocials.map((item) => (
            <a
              class={`header-social header-social--${item.id}`}
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.name}
              title={item.name}
              data-face="smile"
            >
              {item.id === 'vk' && (
                <svg viewBox="7 13 35 24" width="22" height="15" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M25.54 34.5801C14.6 34.5801 8.3601 27.0801 8.1001 14.6001H13.5801C13.7601 23.7601 17.8 27.6401 21 28.4401V14.6001H26.1602V22.5001C29.3202 22.1601 32.6398 18.5601 33.7598 14.6001H38.9199C38.0599 19.4801 34.4599 23.0801 31.8999 24.5601C34.4599 25.7601 38.5601 28.9001 40.1201 34.5801H34.4399C33.2199 30.7801 30.1802 27.8401 26.1602 27.4401V34.5801H25.54Z"
                  />
                </svg>
              )}
              {item.id === 'telegram' && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M20.7 4.6 3.4 11.2c-1.2.5-1.2 1.2-.2 1.5l4.4 1.4 10.2-6.4c.5-.3.9-.1.6.2l-8.2 7.4-.3 4.5c.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.4-1.6Z"
                  />
                </svg>
              )}
            </a>
          ))
        }
      </div>
      <a class="header-phone" href={`tel:${site.phoneTel}`} data-phone-copy={site.phone} data-face="smile">
        <svg class="header-phone-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 3c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"
          />
        </svg>
        {site.phone}
      </a>
    </div>
  </div>
</header>

<p class="copy-toast" data-copy-toast role="status">Телефон скопирован</p>

<script>
  const toastTimers = new WeakMap();

  function isMobilePhone() {
    const uaData = navigator.userAgentData;
    if (uaData && typeof uaData.mobile === 'boolean') return uaData.mobile;
    return /Mobi|Android.*Mobile|iPhone|iPod/i.test(navigator.userAgent);
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.left = '-9999px';
      document.body.appendChild(field);
      field.select();
      const ok = document.execCommand('copy');
      field.remove();
      return ok;
    }
  }

  function showCopied() {
    const toast = document.querySelector('[data-copy-toast]');
    if (!(toast instanceof HTMLElement)) return;
    toast.classList.add('is-on');
    const prev = toastTimers.get(toast);
    if (prev) clearTimeout(prev);
    toastTimers.set(
      toast,
      setTimeout(() => toast.classList.remove('is-on'), 2200),
    );
  }

  document.addEventListener('click', async (event) => {
    const link = event.target instanceof Element ? event.target.closest('[data-phone-copy]') : null;
    if (!(link instanceof HTMLAnchorElement)) return;
    if (isMobilePhone()) return;
    event.preventDefault();
    const text = link.getAttribute('data-phone-copy') ?? '';
    if (await copyText(text)) showCopied();
  });
</script>
