---
import { site } from '../data/site';
---

<section class="partners wrap" aria-labelledby="partners-title">
  <p class="hero-kicker partners-kicker">Партнёрства</p>
  <h2 id="partners-title">Мне доверяют</h2>
  <p class="partners-lede">Образовательные программы, корпоративные игры и проекты для бизнеса.</p>
  <ul class="partners-grid">
    {
      site.partners.map((partner) => (
        <li class="partner-card">
          <img src={partner.src} alt={partner.name} width="160" height="56" loading="lazy" decoding="async" />
        </li>
      ))
    }
  </ul>
</section>
