---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: string;
  collapsed?: boolean;
}

const { href, title, description, date, tags = [], cover, collapsed = false } = Astro.props;
const formatted = date.toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class:list={['card', 'article-card', collapsed && 'is-collapsed']} href={href}>
  {
    cover && (
      <img
        class="article-card-cover"
        src={collapsed ? undefined : cover}
        data-cover={cover}
        alt=""
        loading={collapsed ? undefined : 'lazy'}
      />
    )
  }
  <div class="meta">
    <time datetime={date.toISOString()}>{formatted}</time>
    {tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
  </div>
  <h3>{title}</h3>
  <p class="card-excerpt">{description}</p>
</a>
