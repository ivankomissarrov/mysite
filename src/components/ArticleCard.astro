---
import { coverThumb } from '../lib/articles';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: string;
  eager?: boolean;
}

const { href, title, description, date, tags = [], cover, eager = false } = Astro.props;
const formatted = date.toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const thumb = coverThumb(cover);
---

<a class="card article-card" href={href} data-astro-prefetch>
  {
    cover && (
      <img
        class="article-card-cover"
        src={thumb ?? cover}
        alt=""
        decoding="async"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'low'}
        sizes="(max-width: 560px) 90vw, (max-width: 960px) 45vw, 400px"
      />
    )
  }
  <div class="meta">
    <time datetime={date.toISOString()}>{formatted}</time>
    {tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
  </div>
  <h3>{title}</h3>
  <p class="card-excerpt">{description}</p>
</a>
